# Copie este arquivo para instance/database.env (ignorado pelo Git) e preencha a URL.
#
# Supabase: Project Settings > Database > Connect > "Session pooler" (porta 5432).
# Cole a URI exatamente como o painel mostra, trocando [YOUR-PASSWORD] pela senha do banco.
# O app converte para o driver psycopg e exige SSL automaticamente.
IFP_DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
